# Supabase project settings (Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Generate two separate random 32-byte values; keep only on the server.
SESSION_SECRET=replace_with_random_64_hex_chars
ACCOUNT_ENCRYPTION_KEY=replace_with_random_44_char_base64_key

# Paystack secret key — server-side only. Never expose as NEXT_PUBLIC_*
PAYSTACK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_APP_URL=https://dclutr.com.ng

# Optional public key if you later need to expose a browser key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_key_here

# Zoho Mail SMTP (SSL port 465). Add a Zoho app password, never your normal password.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=notification@dclutr.com.ng
SMTP_PASSWORD=your_zoho_app_password
SMTP_FROM=notification@dclutr.com.ng
ADMIN_NOTIFICATION_EMAIL=admin@dclutr.com.ng
CRON_SECRET=replace_with_a_long_random_secret
